+@Serializable
+class BookIndexDto(
+    private val count: Int,
+    private val fields: List<String>,
+    private val groups: List<ChapterDto.Group>,
+    private val books: List<List<JsonElement>>,
+) {
+    fun toBooks(): List<ChapterDto.Book> {
+        check(books.size == count) { "Incomplete Kagane chapter index" }
+        // The compact index declares its column order in fields.
+        return books.map { row ->
+            val values = fields.zip(row).toMap()
+            fun str(key: String) = (values[key] as? JsonPrimitive)?.contentOrNull
+            ChapterDto.Book(
+                id = str("book_id")!!,
+                title = str("title").orEmpty(),
+                createdAt = str("released_at")?.toLongOrNull()
+                    ?.let { Instant.fromEpochSeconds(it).toString() },
+                pagesCount = str("page_count")?.toIntOrNull() ?: 0,
+                number = str("sort_no")?.toFloatOrNull() ?: -1f,
+                chapterNo = str("chapter_no"),
+                volumeNo = str("volume_no"),
+                groups = (values["group_ix"] as? JsonArray).orEmpty()
+                    .mapNotNull { (it as? JsonPrimitive)?.intOrNull?.let(groups::getOrNull) },
+            )
+        }
+    }
+}
